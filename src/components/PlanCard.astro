---
import type { Plan } from '../data/site';

interface Props {
  plan: Plan;
  compact?: boolean;
}
const { plan, compact = false } = Astro.props;
const featuresToShow = compact ? plan.highlights.slice(0, 7) : plan.highlights;

const TRACK_EVENT: Record<string, string> = {
  control: 'click_control',
  '360': 'click_360',
  'cfo-advisory': 'click_cfo',
  'cfo-integral': 'click_cfo',
};
const trackEvent = TRACK_EVENT[plan.slug];
---
<div class:list={['plan-card', { featured: plan.featured }]}>
  {plan.featured && <span class="plan-badge">Más recomendado</span>}
  <h3 class="plan-name">{plan.name}</h3>
  <p class="plan-audience">{plan.audience}</p>
  <div class="plan-price">
    {plan.from && <span class="from">Desde</span>}
    <span class="amount">{plan.priceLabel}</span>
    <span class="period">+ IVA / mes</span>
  </div>
  <p class="plan-pitch">{plan.pitch}</p>
  <div class="plan-features">
    {featuresToShow.map((f) => <div class="plan-feature">{f}</div>)}
  </div>
  {plan.note && <p class="plan-note">{plan.note}</p>}
  <a
    class="plan-cta"
    href={plan.cta.href}
    onclick={trackEvent ? `dcTrack('${trackEvent}', { plan: '${plan.slug}' })` : undefined}
  >{plan.cta.label} →</a>
</div>
