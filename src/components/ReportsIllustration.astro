---
---
<div class="reports-panel">
  <svg class="reports-illustration" viewBox="0 0 400 280" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Ilustración de reportes contables">
    <defs>
      <linearGradient id="rpBg" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#280b4a" />
        <stop offset="100%" stop-color="#05427f" />
      </linearGradient>
      <linearGradient id="rpBar" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0%" stop-color="#3871c1" />
        <stop offset="100%" stop-color="#51ade5" />
      </linearGradient>
    </defs>

    <rect x="0" y="0" width="400" height="280" rx="0" fill="url(#rpBg)" />
    <g opacity=".08">
      <circle cx="360" cy="30" r="90" fill="#ffffff" />
      <circle cx="20" cy="260" r="70" fill="#ffffff" />
    </g>

    <g class="doc" transform="translate(38, 34)">
      <rect x="0" y="0" width="150" height="212" rx="12" fill="#ffffff" opacity=".97" />
      <rect x="18" y="24" width="90" height="10" rx="5" fill="#280b4a" opacity=".7" />
      <rect x="18" y="44" width="60" height="7" rx="3.5" fill="#6b7280" opacity=".5" />

      <g stroke="#e5e3ef" stroke-width="1">
        <line x1="18" y1="66" x2="132" y2="66" />
        <line x1="18" y1="92" x2="132" y2="92" />
        <line x1="18" y1="118" x2="132" y2="118" />
        <line x1="18" y1="144" x2="132" y2="144" />
      </g>
      <rect class="row row-1" x="18" y="72" width="70" height="8" rx="4" fill="#3871c1" opacity=".85" />
      <rect class="row row-2" x="18" y="98" width="95" height="8" rx="4" fill="#51ade5" opacity=".85" />
      <rect class="row row-3" x="18" y="124" width="50" height="8" rx="4" fill="#3871c1" opacity=".6" />

      <circle class="badge-circle" cx="107" cy="178" r="26" fill="none" stroke="#e5e3ef" stroke-width="8" />
      <circle class="badge-progress" cx="107" cy="178" r="26" fill="none" stroke="#3871c1" stroke-width="8"
              stroke-linecap="round" stroke-dasharray="163" stroke-dashoffset="163"
              transform="rotate(-90 107 178)" />
      <text x="107" y="183" text-anchor="middle" font-family="'DM Sans', sans-serif" font-size="13" font-weight="800" fill="#280b4a">76%</text>
      <text x="43" y="183" text-anchor="middle" font-family="'DM Sans', sans-serif" font-size="9" font-weight="700" fill="#6b7280">Cierre</text>
    </g>

    <g class="bars" transform="translate(210, 60)">
      <rect class="rbar rb-1" x="0" y="110" width="24" height="70" rx="5" fill="url(#rpBar)" />
      <rect class="rbar rb-2" x="34" y="80" width="24" height="100" rx="5" fill="url(#rpBar)" />
      <rect class="rbar rb-3" x="68" y="40" width="24" height="140" rx="5" fill="url(#rpBar)" />
      <rect class="rbar rb-4" x="102" y="95" width="24" height="85" rx="5" fill="#ffffff" opacity=".5" />
      <rect class="rbar rb-5" x="136" y="20" width="24" height="160" rx="5" fill="url(#rpBar)" />
    </g>

    <g class="badge-top" transform="translate(210, 30)">
      <rect x="0" y="0" width="112" height="24" rx="12" fill="rgba(255,255,255,.14)" stroke="rgba(255,255,255,.28)" />
      <text x="56" y="16" text-anchor="middle" font-family="'DM Sans', sans-serif" font-size="10.5" font-weight="700" fill="#ffffff">Reportes al día</text>
    </g>
  </svg>
</div>

<style>
  .reports-panel { width: 100%; border-radius: 18px; overflow: hidden; box-shadow: 0 20px 50px rgba(40,11,74,.12); line-height: 0; margin-bottom: 32px; }
  .reports-illustration { width: 100%; height: 280px; display: block; }
  .row { transform-origin: left; animation: growRow .8s cubic-bezier(.2,.8,.2,1) backwards; }
  .row-1 { animation-delay: .1s; }
  .row-2 { animation-delay: .2s; }
  .row-3 { animation-delay: .3s; }
  @keyframes growRow { from { transform: scaleX(0); opacity: 0; } to { transform: scaleX(1); opacity: .85; } }
  .rbar { transform-origin: bottom; animation: riseBar 1s cubic-bezier(.2,.8,.2,1) backwards; }
  .rb-1 { animation-delay: .05s; }
  .rb-2 { animation-delay: .15s; }
  .rb-3 { animation-delay: .25s; }
  .rb-4 { animation-delay: .35s; }
  .rb-5 { animation-delay: .45s; }
  @keyframes riseBar { from { transform: scaleY(0); opacity: 0; } to { transform: scaleY(1); opacity: 1; } }
  .badge-progress { animation: fillRing 1.2s .5s cubic-bezier(.2,.8,.2,1) forwards; }
  @keyframes fillRing { to { stroke-dashoffset: 39; } }
  .badge-top { animation: fadeIn .6s 1s ease-out backwards; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
</style>
