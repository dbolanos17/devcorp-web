---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  title: string;
  sub?: string;
  crumbs?: Crumb[];
}
const { title, sub, crumbs = [] } = Astro.props;
---
<div class="page-hero">
  <div class="hero-grid"></div>
  <div class="page-hero-inner">
    {crumbs.length > 0 && (
      <div class="breadcrumb">
        {crumbs.map((c, i) => (
          <>
            {c.href ? <a href={c.href}>{c.label}</a> : c.label}
            {i < crumbs.length - 1 && <span class="sep">/</span>}
          </>
        ))}
      </div>
    )}
    <h1>{title}</h1>
    {sub && <p>{sub}</p>}
  </div>
</div>
