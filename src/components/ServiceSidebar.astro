---
import { SPECIALIZED_SERVICES } from '../data/site';
interface Props {
  current: string;
}
const { current } = Astro.props;
---
<aside class="svc-sidebar">
  <h4>Servicios relacionados</h4>
  <div class="svc-sidebar-list">
    {SPECIALIZED_SERVICES.map((s) => (
      <a class:list={[{ active: s.slug === current }]} href={`/servicios/${s.slug}/`} aria-current={s.slug === current ? 'page' : undefined}>
        {s.icon} {s.title}
      </a>
    ))}
  </div>
  <a class="btn-primary" style="width:100%;justify-content:center;" href="/diagnostico/" onclick="dcTrack('click_diagnostico', { location: 'svc-sidebar' })">Solicitar diagnóstico →</a>
</aside>
