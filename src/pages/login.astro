---
import Base from '../layouts/Base.astro';
---
<Base
  title="Portal de Clientes — DEVCORP S.A.S."
  description="Inicia sesión en el Portal de Clientes de DEVCORP para ver tus documentos, facturas y el estado de tus asesorías."
>
  <div class="auth-wrap">
    <div class="hero-grid"></div><div class="hero-glow-1"></div>
    <div class="auth-card">
      <div class="auth-logo"><span class="logo-text" style="color:var(--text);">DEVCORP</span></div>
      <h2>Portal de Clientes</h2>
      <p class="sub">Inicia sesión para ver tus documentos, facturas y el estado de tus asesorías.</p>
      <form id="form-login">
        <div class="form-group"><label>Correo electrónico</label><input type="email" required placeholder="tucorreo@ejemplo.com" /></div>
        <div class="form-group"><label>Contraseña</label><input type="password" required placeholder="••••••••" /></div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
          <label class="form-check" style="margin-bottom:0;"><input type="checkbox" /> Recordarme</label>
          <span style="font-size:.82rem;color:var(--blue);font-weight:600;">¿Olvidaste tu contraseña?</span>
        </div>
        <button class="btn-submit" type="submit">Iniciar Sesión →</button>
        <p class="form-notice" id="login-notice">El Portal de Clientes estará disponible muy pronto. Mientras tanto, contáctanos por WhatsApp para cualquier consulta sobre tus documentos.</p>
      </form>
      <div class="auth-switch">¿Aún no tienes cuenta? <a href="/registro/">Regístrate aquí</a></div>
    </div>
  </div>

  <script>
    document.getElementById('form-login')?.addEventListener('submit', (e) => {
      e.preventDefault();
      document.getElementById('login-notice')?.classList.add('show');
    });
  </script>
</Base>
