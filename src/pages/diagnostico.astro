---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE, PLANS, waLink, WA_MESSAGES } from '../data/site';

const FACTURACION = [
  'Menos de $5.000',
  '$5.000 – $10.000',
  '$10.000 – $25.000',
  '$25.000 – $50.000',
  '$50.000 – $100.000',
  'Más de $100.000',
];
const TRANSACCIONES = ['Menos de 50', '50 – 150', '151 – 300', '301 – 600', 'Más de 600', 'No lo sé'];
const CONTABILIDAD_ACTUAL = ['Yo mismo', 'Contador independiente', 'Contador interno', 'Firma externa', 'Actualmente nadie', 'Otro'];
const DESAFIOS = [
  'Cumplimiento tributario',
  'Contabilidad desordenada',
  'Nómina / laboral',
  'No tengo información para decidir',
  'Flujo de caja',
  'Rentabilidad',
  'Impuestos altos / sin planificación',
  'Crecimiento de la empresa',
  'Necesito CFO / dirección financiera',
  'Otro',
];
---
<Base
  title="Diagnóstico Empresarial 360 | DEVCORP"
  description="En pocos minutos conoceremos la situación de tu empresa y determinaremos qué nivel de acompañamiento contable-financiero necesitas."
>
  <PageHero
    title="Diagnóstico Empresarial DEVCORP 360"
    sub="En pocos minutos conoceremos la situación de tu empresa y determinaremos qué nivel de acompañamiento contable-financiero necesitas."
    crumbs={[{ label: 'Inicio', href: '/' }, { label: 'Diagnóstico' }]}
  />

  <div class="section">
    <div class="form-card" style="max-width:760px;margin:0 auto;">
      <ol class="diag-progress" aria-label="Progreso del formulario" style="list-style:none;padding:0;">
        <li class="diag-progress-step active" id="prog-1" aria-current="step"><span class="dot">1</span> Tus datos</li>
        <li class="diag-progress-line" aria-hidden="true"></li>
        <li class="diag-progress-step" id="prog-2"><span class="dot">2</span> Tu empresa</li>
      </ol>

      <form id="form-diagnostico" data-key={SITE.web3formsKey}>
        <!-- PASO 1 -->
        <div class="diag-step" data-step="1">
          <p class="diag-promise">Son solo 2 pasos. <strong>Te respondemos en {SITE.responseTime}</strong> con una recomendación de plan para tu empresa.</p>
          <div class="form-row">
            <div class="form-group"><label for="d-nombre">Nombre completo *</label><input id="d-nombre" type="text" name="nombre" autocomplete="name" required /></div>
            <div class="form-group"><label for="d-empresa">Empresa *</label><input id="d-empresa" type="text" name="empresa" autocomplete="organization" required /></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label for="d-whatsapp">WhatsApp *</label><input id="d-whatsapp" type="tel" name="whatsapp" autocomplete="tel" required /></div>
            <div class="form-group"><label for="d-email">Email *</label><input id="d-email" type="email" name="email" autocomplete="email" required /></div>
          </div>
          <div class="diag-actions">
            <button class="btn-submit" type="submit" id="diag-next">Continuar →</button>
          </div>
        </div>

        <!-- PASO 2 (deshabilitado hasta que se muestra, para no bloquear el envío del paso 1) -->
        <fieldset class="diag-step" data-step="2" hidden disabled style="border:0;padding:0;margin:0;min-width:0;">
          <legend class="sr-only">Datos de tu empresa</legend>
          <div class="form-row">
            <div class="form-group"><label for="d-ciudad">Ciudad *</label><input id="d-ciudad" type="text" name="ciudad" autocomplete="address-level2" required placeholder="Quito, Guayaquil, Cuenca..." /></div>
            <div class="form-group"><label for="d-actividad">Actividad económica *</label><input id="d-actividad" type="text" name="actividad" autocomplete="off" required /></div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="d-facturacion">Facturación mensual aproximada *</label>
              <select id="d-facturacion" name="facturacion" required>
                <option value="" disabled selected>Selecciona un rango</option>
                {FACTURACION.map((f) => <option>{f}</option>)}
              </select>
            </div>
            <div class="form-group"><label for="d-empleados">Número de empleados *</label><input id="d-empleados" type="number" name="empleados" min="0" inputmode="numeric" required /></div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="d-transacciones">Transacciones/documentos mensuales aproximados *</label>
              <select id="d-transacciones" name="transacciones" required>
                <option value="" disabled selected>Selecciona un rango</option>
                {TRANSACCIONES.map((t) => <option>{t}</option>)}
              </select>
            </div>
            <div class="form-group"><label for="d-cuentas">Número aproximado de cuentas bancarias *</label><input id="d-cuentas" type="number" name="cuentas" min="0" inputmode="numeric" required /></div>
          </div>
          <div class="form-group">
            <label for="d-contabilidad">¿Quién maneja actualmente tu contabilidad? *</label>
            <select id="d-contabilidad" name="contabilidad_actual" required>
              <option value="" disabled selected>Selecciona una opción</option>
              {CONTABILIDAD_ACTUAL.map((c) => <option>{c}</option>)}
            </select>
          </div>
          <div class="form-group">
            <label for="d-desafio">¿Cuál es tu principal desafío? *</label>
            <select id="d-desafio" name="desafio" required>
              <option value="" disabled selected>Selecciona una opción</option>
              {DESAFIOS.map((d) => <option>{d}</option>)}
            </select>
          </div>
          <div class="form-group">
            <label for="d-servicio">Servicio que más te interesa</label>
            <select id="d-servicio" name="servicio_interes">
              {PLANS.map((p) => <option>{p.name}</option>)}
              <option>No estoy seguro — quiero que me recomienden</option>
            </select>
          </div>
          <div class="hp" aria-hidden="true"><label>No marcar esta casilla <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label></div>
          <div class="form-check">
            <input id="d-consent" type="checkbox" name="consentimiento" required />
            <label for="d-consent">Acepto el tratamiento de mis datos personales conforme a la
            <a href="/politica-de-privacidad/" target="_blank">política de privacidad</a> de DEVCORP S.A.S.</label>
          </div>
          <div class="diag-actions">
            <button class="btn-back" type="button" id="diag-back">← Atrás</button>
            <button class="btn-submit" type="submit" id="diag-btn">Solicitar diagnóstico</button>
          </div>
        </fieldset>
        <p class="form-notice" id="diag-notice" role="status" aria-live="polite"></p>
      </form>

      <div id="diag-success" style="display:none;text-align:center;padding:20px 0;" role="status" tabindex="-1">
        <p style="font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:800;color:var(--purple);margin-bottom:10px;">
          Gracias. Revisaremos la información y nos pondremos en contacto en {SITE.responseTime} para coordinar tu diagnóstico.
        </p>
        <a class="btn-wa" href={waLink(WA_MESSAGES.diagnostico)} target="_blank" rel="noopener" style="margin-top:14px;display:inline-flex;">
          📱 Hablar por WhatsApp mientras tanto
        </a>
      </div>
    </div>
  </div>

  <script define:vars={{ WEB3FORMS_KEY: SITE.web3formsKey }}>
    const form = document.getElementById('form-diagnostico');
    const step1 = form.querySelector('[data-step="1"]');
    const step2 = form.querySelector('[data-step="2"]');
    const prog1 = document.getElementById('prog-1');
    const prog2 = document.getElementById('prog-2');
    let step = 1;
    let started = false;

    form.addEventListener('input', () => {
      if (!started) {
        started = true;
        if (window.dcTrack) window.dcTrack('start_diagnostico');
      }
    });

    function goTo(n) {
      step = n;
      const two = n === 2;
      step1.hidden = two;
      step2.hidden = !two;
      step2.disabled = !two;
      prog1.classList.toggle('active', !two);
      prog2.classList.toggle('active', two);
      prog1.removeAttribute('aria-current');
      prog2.removeAttribute('aria-current');
      (two ? prog2 : prog1).setAttribute('aria-current', 'step');
      document.getElementById('diag-notice').classList.remove('show');
      const first = (two ? step2 : step1).querySelector('input, select');
      first?.focus();
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    document.getElementById('diag-back').addEventListener('click', () => goTo(1));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Paso 1 → paso 2 (los campos del paso 1 ya pasaron la validación nativa).
      if (step === 1) {
        if (window.dcTrack) window.dcTrack('diagnostico_paso_2');
        goTo(2);
        return;
      }

      const btn = document.getElementById('diag-btn');
      const notice = document.getElementById('diag-notice');
      const d = new FormData(form);

      // Trampa anti-spam: los humanos no ven esta casilla; si llega marcada, es un bot.
      if (d.get('botcheck')) { form.reset(); return; }

      btn.disabled = true;
      btn.textContent = 'Enviando...';
      notice.classList.remove('show');

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: WEB3FORMS_KEY,
            subject: 'Nuevo Diagnóstico Empresarial 360 — ' + d.get('empresa'),
            from_name: 'Sitio Web DEVCORP — Diagnóstico',
            replyto: d.get('email'),
            'Nombre': d.get('nombre'),
            'Empresa': d.get('empresa'),
            'WhatsApp': d.get('whatsapp'),
            'Email': d.get('email'),
            'Ciudad': d.get('ciudad'),
            'Actividad económica': d.get('actividad'),
            'Facturación mensual aproximada': d.get('facturacion'),
            'Número de empleados': d.get('empleados'),
            'Transacciones mensuales aproximadas': d.get('transacciones'),
            'Cuentas bancarias': d.get('cuentas'),
            'Quién maneja la contabilidad actualmente': d.get('contabilidad_actual'),
            'Principal desafío': d.get('desafio'),
            'Servicio de interés': d.get('servicio_interes'),
          }),
        });
        const data = await res.json();
        if (data.success) {
          if (window.dcTrack) window.dcTrack('submit_diagnostico');
          form.style.display = 'none';
          document.querySelector('.diag-progress').style.display = 'none';
          const ok = document.getElementById('diag-success');
          ok.style.display = 'block';
          ok.focus();
        } else {
          notice.textContent = '⚠️ No se pudo enviar el formulario. Intenta de nuevo o escríbenos a info@devcorp-ec.com.';
          notice.classList.add('show');
        }
      } catch {
        notice.textContent = '⚠️ No se pudo enviar el formulario. Intenta de nuevo o escríbenos a info@devcorp-ec.com.';
        notice.classList.add('show');
      }

      btn.disabled = false;
      btn.textContent = 'Solicitar diagnóstico';
    });
  </script>
</Base>
