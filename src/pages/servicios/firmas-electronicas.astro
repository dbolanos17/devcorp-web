---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE, FIRMA_PRECIOS, firmaPrecioTexto } from '../../data/site';

// Las tarifas viven en src/data/firma-precios.js (también las valida el servidor).
const PRECIOS = FIRMA_PRECIOS.map((p) => ({ ...p, priceText: firmaPrecioTexto(p) }));
const desde = PRECIOS[0].priceText;
---
<Base
  title="Firmas Electrónicas en Ecuador — DEVCORP S.A.S."
  description={`Obtén tu firma electrónica en minutos, para personas naturales o jurídicas, con validez legal en Ecuador. Vigencia de 1 a 5 años desde ${desde}.`}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://cdn.payphonetodoesposible.com/box/v2.0/payphone-payment-box.css" />
    <script type="module" src="https://cdn.payphonetodoesposible.com/box/v2.0/payphone-payment-box.js"></script>
    <!-- defer: el SDK de PayPal ya no bloquea el pintado de la página. Solo se usa
         cuando el cliente interactúa con el formulario, mucho después de cargar. -->
    <script defer src={`https://www.paypal.com/sdk/js?client-id=${SITE.paypalClientId}&currency=USD`}></script>
    <!-- El CSS de PayPhone trae "html{font-size:13px}" y encoge todo el sitio
         (que usa rem) en esta página, incluido el menú. Se restaura el tamaño
         base normal del navegador. -->
    <style>html { font-size: 16px !important; }</style>
  </Fragment>
  <PageHero
    title="Firmas Electrónicas"
    sub="Obtén tu firma electrónica en minutos. Completa el formulario y te contactamos de inmediato."
    crumbs={[{ label: 'Inicio', href: '/' }, { label: 'Servicios', href: '/servicios/' }, { label: 'Firmas Electrónicas' }]}
  />
  <div class="section">
    <div class="svc-detail-grid">
      <div class="svc-detail-body">
        <h2>Rápida, segura y válida legalmente</h2>
        <p>Ofrecemos la emisión de firmas electrónicas para personas naturales y jurídicas, con validez legal en Ecuador, en un proceso simple y guiado por nuestro equipo.</p>
        <h2>¿Qué incluye?</h2>
        <div class="check-list">
          <div class="check-item"><span class="check-icon">✓</span>Emisión para persona natural o jurídica</div>
          <div class="check-item"><span class="check-icon">✓</span>Firma con RUC (opcional)</div>
          <div class="check-item"><span class="check-icon">✓</span>Acompañamiento en la carga de documentos</div>
          <div class="check-item"><span class="check-icon">✓</span>Entrega en minutos una vez validada la información</div>
        </div>
        <h2>Tarifas vigentes</h2>
        <div class="price-table">
          {PRECIOS.map((p) => (
            <div class="price-row"><span>{p.label}</span><strong>{p.priceText}</strong></div>
          ))}
        </div>
      </div>
      <aside class="svc-sidebar">
        <h2>Solicita tu firma electrónica</h2>
        <form id="form-firmas" data-key={SITE.web3formsKey}>
          <div class="form-group"><label class="sr-only" for="f-nombre">Apellidos y nombres completos</label><input id="f-nombre" type="text" name="nombre" placeholder="Apellidos y nombres completos *" autocomplete="name" required /></div>
          <div class="form-group"><label class="sr-only" for="f-cedula">Cédula de identidad</label><input id="f-cedula" type="text" name="cedula" placeholder="Cédula de identidad *" inputmode="numeric" autocomplete="off" required /></div>
          <div class="form-group"><label class="sr-only" for="f-correo">Correo electrónico</label><input id="f-correo" type="email" name="correo" placeholder="Correo electrónico *" autocomplete="email" required /></div>
          <div class="form-group"><label class="sr-only" for="f-telefono">Número de teléfono</label><input id="f-telefono" type="tel" name="telefono" placeholder="Número de teléfono *" autocomplete="tel" required /></div>
          <div class="form-group">
            <label class="sr-only" for="f-tipo">Persona natural o jurídica</label>
            <select id="f-tipo" name="tipo" required>
              <option value="" disabled selected>Persona Natural o Jurídica *</option>
              <option>Persona Natural</option>
              <option>Persona Jurídica</option>
            </select>
          </div>
          <div class="form-group"><label class="sr-only" for="f-ruc">RUC (si aplica)</label><input id="f-ruc" type="text" name="ruc" placeholder="RUC (si aplica)" inputmode="numeric" autocomplete="off" /></div>
          <div class="form-group">
            <label class="sr-only" for="firma-vigencia">Años de vigencia</label>
            <select name="vigencia" id="firma-vigencia" required>
              <option value="" disabled selected>Años de vigencia *</option>
              {PRECIOS.map((p) => (
                <option value={`${p.label} — ${p.priceText}`} data-price={p.priceText} data-years={p.years}>{p.label} — {p.priceText}</option>
              ))}
            </select>
          </div>
          <div class="form-group">
            <label for="firma-file">Cédula (y RUC si aplica, en un solo PDF o imagen) — opcional, máx. 1 MB</label>
            <input type="file" id="firma-file" name="attachment" accept=".pdf,.jpg,.jpeg,.png" />
          </div>
          <p class="price-hint">Total a pagar: <strong id="firma-precio">—</strong></p>
          <div class="hp" aria-hidden="true"><label>No marcar esta casilla <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label></div>
          <div class="form-check"><input id="f-acepta" type="checkbox" name="acepta" required /> <label for="f-acepta">Acepto la <a href="/politica-de-privacidad/" target="_blank">política de privacidad</a> y los <a href="/terminos-y-condiciones/" target="_blank">términos y condiciones</a>.</label></div>
          <button class="btn-submit" type="submit" id="firmas-btn">Enviar solicitud</button>
          <p class="file-hint">Si no adjuntas tus documentos ahora, te contactamos para recibirlos y coordinar el pago.</p>
          <p class="form-notice" id="firmas-notice" role="status" aria-live="polite"></p>
        </form>

        <div class="pay-divider"><span>o paga en línea ahora</span></div>
        <p class="file-hint" id="pay-hint">Completa tus datos, elige la vigencia y acepta los términos para habilitar el pago.</p>
        <div id="payphone-button" class="pay-widget"></div>
        <div id="paypal-button-container" class="pay-widget"></div>
        <p class="form-notice" id="pay-notice" role="status" aria-live="polite"></p>
        <div id="pay-success" class="pay-success" role="status" tabindex="-1"></div>
      </aside>
    </div>
  </div>

  <script define:vars={{ PAYPHONE_TOKEN: SITE.payphone.token }}>
    const sel = document.getElementById('firma-vigencia');
    sel?.addEventListener('change', () => {
      const price = sel.options[sel.selectedIndex]?.dataset.price ?? '—';
      const el = document.getElementById('firma-precio');
      if (el) el.textContent = price;
      scheduleRefresh();
    });

    // ─── Pago en línea (PayPhone + PayPal) ───
    // Importante: el precio real lo decide el servidor a partir de la vigencia
    // (src/data/firma-precios.js). El monto de aquí solo sirve para mostrarlo y
    // para armar la cajita de PayPhone; el servidor lo verifica igualmente.
    const REQUIRED_FIELDS = ['nombre', 'cedula', 'correo', 'telefono', 'tipo'];

    // La cajita de PayPhone se reconstruye cada vez que cambian los datos, y cada
    // reconstrucción crea una transacción en PayPhone. Por eso se espera a que el
    // cliente deje de escribir (400 ms) y, mientras tanto, la caja anterior se
    // retira para que nunca quede visible con un monto desactualizado.
    let refreshTimer;
    function scheduleRefresh() {
      document.getElementById('payphone-button').innerHTML = '';
      clearTimeout(refreshTimer);
      refreshTimer = setTimeout(refreshPaymentButtons, 400);
    }
    document.querySelectorAll('#form-firmas input[name], #form-firmas select[name]').forEach((el) => {
      el.addEventListener('input', scheduleRefresh);
      el.addEventListener('change', scheduleRefresh);
    });

    function getCustomer() {
      const form = document.getElementById('form-firmas');
      const d = new FormData(form);
      const opt = sel?.options[sel.selectedIndex];
      return {
        nombre: d.get('nombre'),
        cedula: d.get('cedula'),
        correo: d.get('correo'),
        telefono: d.get('telefono'),
        tipo: d.get('tipo'),
        ruc: d.get('ruc') || 'No aplica',
        vigencia: opt?.value || '',
        years: opt?.dataset.years ? Number(opt.dataset.years) : 0,
        amount: opt?.dataset.price ? parseFloat(opt.dataset.price.replace('$', '')) : 0,
        acepta: !!d.get('acepta'),
      };
    }

    function customerIsValid(c) {
      return REQUIRED_FIELDS.every((f) => c[f] && String(c[f]).trim() !== '') && c.amount > 0 && c.years > 0 && c.acepta;
    }

    function genClientTxId() {
      return 'DEVCORP-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8);
    }

    let paypalRendered = false;

    function refreshPaymentButtons() {
      const c = getCustomer();
      const hint = document.getElementById('pay-hint');
      const payphoneBox = document.getElementById('payphone-button');
      payphoneBox.innerHTML = '';

      if (!customerIsValid(c)) {
        hint.style.display = 'block';
        return;
      }
      hint.style.display = 'none';

      const clientTransactionId = genClientTxId();
      try { localStorage.setItem(clientTransactionId, JSON.stringify(c)); } catch (e) { /* modo privado */ }

      // PayPhone requiere reconstruir la caja cada vez que cambia el monto.
      // storeId se omite a propósito: PayPhone lo toma como opcional y, con
      // una sola tienda asociada al Token, enviarlo causaba el error
      // "La tienda asociada no existe" (Error 100).
      // @ts-ignore — clase global cargada desde el script del CDN de PayPhone
      new PPaymentButtonBox({
        token: PAYPHONE_TOKEN,
        clientTransactionId,
        amount: Math.round(c.amount * 100),
        amountWithoutTax: Math.round(c.amount * 100),
        amountWithTax: 0,
        tax: 0,
        service: 0,
        tip: 0,
        currency: 'USD',
        reference: 'Firma Electrónica DEVCORP — ' + c.vigencia,
        email: c.correo,
        phoneNumber: c.telefono,
        documentId: c.cedula,
        identificationType: c.tipo === 'Persona Jurídica' ? 2 : 1,
        lang: 'es',
        responseUrl: window.location.origin + window.location.pathname,
      }).render('payphone-button');

      if (!paypalRendered && window.paypal) {
        paypalRendered = true;
        // @ts-ignore — SDK global cargado desde el script de PayPal
        paypal.Buttons({
          createOrder: async () => {
            const cust = getCustomer();
            if (!customerIsValid(cust)) {
              showPayNotice('⚠️ Completa tus datos, elige la vigencia y acepta los términos antes de pagar.');
              throw new Error('Datos incompletos');
            }
            const res = await fetch('/.netlify/functions/paypal-capture', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              // Solo se envía la vigencia: el servidor busca el precio.
              body: JSON.stringify({ action: 'create', years: cust.years }),
            });
            const data = await res.json();
            if (!data.id) {
              showPayNotice('⚠️ No se pudo iniciar el pago con PayPal. Intenta de nuevo o escríbenos a info@devcorp-ec.com.');
              throw new Error('Orden no creada');
            }
            return data.id;
          },
          onApprove: async (data) => {
            const cust = getCustomer();
            const res = await fetch('/.netlify/functions/paypal-capture', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'capture', orderID: data.orderID, customer: cust }),
            });
            const result = await res.json();
            if (result.success) {
              showPayResult(result);
            } else {
              showPayNotice('⚠️ No se pudo confirmar el pago con PayPal. Escríbenos a info@devcorp-ec.com.');
            }
          },
          onError: () => showPayNotice('⚠️ Ocurrió un error con PayPal. Intenta de nuevo.'),
        }).render('#paypal-button-container');
      }
    }

    function showPayNotice(text) {
      const notice = document.getElementById('pay-notice');
      notice.textContent = text;
      notice.classList.add('show');
    }

    // Comprobante en pantalla tras un pago confirmado por el servidor.
    // result.review = el servidor cobró pero el monto no coincidió con la tarifa: se revisa a mano.
    function showPayResult(result) {
      document.getElementById('pay-notice').classList.remove('show');
      const box = document.getElementById('pay-success');
      box.replaceChildren();
      box.classList.add('show');
      box.classList.toggle('pay-review', !!result.review);

      const title = document.createElement('strong');
      title.textContent = result.review ? 'Recibimos tu pago y lo estamos verificando' : '¡Pago recibido!';
      const code = document.createElement('code');
      code.textContent = String(result.transactionId ?? '—');
      const p1 = document.createElement('div');
      p1.append('Tu código de transacción es ', code, '. Guárdalo como comprobante.');
      const p2 = document.createElement('div');
      p2.style.marginTop = '8px';
      p2.textContent = result.review
        ? 'Un asesor revisará el pago y te contactará al correo o teléfono que registraste.'
        : 'Nuestro equipo validará tu información y te contactará al correo o teléfono que registraste para completar la emisión de tu firma. Si aún no enviaste tus documentos (cédula y RUC, si aplica), te los pediremos en ese contacto.';
      box.append(title, p1, p2);

      const form = document.getElementById('form-firmas');
      form?.reset();
      document.getElementById('firma-precio').textContent = '—';
      document.getElementById('payphone-button').innerHTML = '';
      document.getElementById('pay-hint').style.display = 'block';
      box.scrollIntoView({ behavior: 'smooth', block: 'center' });
      box.focus();
      if (window.dcTrack) window.dcTrack('pago_firma_confirmado', { review: !!result.review });
    }

    // Si volvemos de un redireccionamiento de PayPhone, confirmar el pago.
    (async function checkPayphoneReturn() {
      const params = new URLSearchParams(window.location.search);
      const id = params.get('id');
      const clientTxId = params.get('clientTransactionId') || params.get('clientTxId');
      if (!id || !clientTxId) return;

      history.replaceState({}, '', window.location.pathname);
      showPayNotice('Confirmando tu pago...');

      let customer = null;
      try {
        const stored = localStorage.getItem(clientTxId);
        customer = stored ? JSON.parse(stored) : null;
      } catch (e) { /* sin datos locales: el servidor lo marcará para revisión */ }

      try {
        const res = await fetch('/.netlify/functions/payphone-confirm', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, clientTxId, customer }),
        });
        const result = await res.json();
        if (result.success) {
          try { localStorage.removeItem(clientTxId); } catch (e) {}
          showPayResult(result);
        } else {
          showPayNotice('⚠️ El pago no pudo confirmarse. Escríbenos a info@devcorp-ec.com.');
        }
      } catch {
        showPayNotice('⚠️ No se pudo confirmar el pago. Escríbenos a info@devcorp-ec.com.');
      }
    })();

    const form = document.getElementById('form-firmas');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('firmas-btn');
      const notice = document.getElementById('firmas-notice');
      const d = new FormData(form);

      // Trampa anti-spam: los humanos no ven esta casilla; si llega marcada, es un bot.
      if (d.get('botcheck')) { form.reset(); return; }

      const fileInput = document.getElementById('firma-file');
      const file = fileInput?.files?.[0];
      if (file && file.size > 1024 * 1024) {
        notice.textContent = '⚠️ El archivo supera 1 MB. Reduce su tamaño o envíalo luego por WhatsApp/correo.';
        notice.classList.add('show');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Enviando...';
      notice.classList.remove('show');

      // Con archivo adjunto, Web3Forms requiere FormData (multipart) en vez de JSON —
      // no se debe fijar Content-Type manualmente, el navegador arma el boundary.
      const payload = new FormData();
      payload.append('access_key', form.dataset.key);
      payload.append('subject', `Solicitud de Firma Electrónica — ${d.get('nombre')}`);
      payload.append('from_name', 'Sitio Web DEVCORP');
      payload.append('replyto', d.get('correo'));
      payload.append('Nombre', d.get('nombre'));
      payload.append('Cédula', d.get('cedula'));
      payload.append('Correo', d.get('correo'));
      payload.append('Teléfono', d.get('telefono'));
      payload.append('Tipo', d.get('tipo'));
      payload.append('RUC', d.get('ruc') || 'No aplica');
      payload.append('Vigencia', d.get('vigencia'));
      if (file) payload.append('attachment', file);

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: payload,
        });
        const data = await res.json();
        if (data.success) {
          notice.textContent = 'Solicitud enviada correctamente. Te contactaremos en ' + 'menos de 24 horas' + '.';
          form.reset();
          document.getElementById('firma-precio').textContent = '—';
        } else {
          notice.textContent = '⚠️ No se pudo enviar la solicitud. Intenta de nuevo o escríbenos a info@devcorp-ec.com.';
        }
      } catch {
        notice.textContent = '⚠️ No se pudo enviar la solicitud. Intenta de nuevo o escríbenos a info@devcorp-ec.com.';
      }

      notice.classList.add('show');
      btn.disabled = false;
      btn.textContent = 'Enviar solicitud';
    });
  </script>
</Base>
