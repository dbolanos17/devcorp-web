---
import Base from '../layouts/Base.astro';
import FinalCta from '../components/FinalCta.astro';
import { SITE, waLink, WA_MESSAGES } from '../data/site';
---
<Base
  title="Nosotros — DEVCORP S.A.S. | Aliados estratégicos del crecimiento empresarial"
  description="DEVCORP S.A.S. es una firma ecuatoriana de outsourcing contable, tributario, laboral y financiero para PYMEs. Conoce nuestro enfoque y equipo."
>
  <div class="section" style="padding-top:100px;">
    <div class="about-grid">
      <div class="about-text">
        <span class="tag">Nosotros</span>
        <h1 style="font-family:'Playfair Display',serif;font-size:clamp(1.8rem,3vw,2.4rem);font-weight:900;line-height:1.25;color:var(--text);margin:14px 0 20px;">Aliados estratégicos del crecimiento empresarial</h1>
        <p>DEVCORP S.A.S. es una firma ecuatoriana que ofrece el respaldo de una asesoría profesional y confiable en torno a los aspectos financieros, contables, tributarios y laborales de empresas, personas naturales, jurídicas y organizaciones no gubernamentales.</p>
        <p>Evaluamos, diseñamos y proponemos estrategias personalizadas que se adaptan a las necesidades y oportunidades de cada organización, siempre en estricto cumplimiento con la normativa vigente. {SITE.coverage}.</p>
      </div>
      <div class="about-img">
        <div class="about-photo-wrap">
          <div class="about-photo-frame">
            <img src="/images/nosotros-hero-white.jpg" alt="David Bolaños, Presidente de DEVCORP S.A.S." loading="lazy" />
          </div>
          <div class="about-photo-caption">
            <strong>David Bolaños</strong>
            <span>Presidente · DEVCORP S.A.S.</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="about-solo">
      <span class="tag">Nuestro enfoque</span>
      <h2>Asesoría profesional y confiable, desde el conocimiento normativo</h2>
      <p>Somos una firma de origen ecuatoriano con un equipo multidisciplinario que conoce a fondo la normativa contable, tributaria, laboral y societaria del país — porque operar en Ecuador exige entender sus reglas, no solo procesar información.</p>
      <p>No entregamos solamente balances: ayudamos a entender qué está pasando en el negocio y qué decisión tomar. Cada organización recibe estrategias diseñadas a su medida, con estricto apego a la normativa vigente y bajo total confidencialidad.</p>
    </div>
  </div>

  <div class="section section-alt">
    <div class="section-header center">
      <span class="tag">Misión &amp; Visión</span>
      <h2 class="section-title">El rumbo que <span class="hi">nos guía</span></h2>
    </div>
    <div class="values-row">
      <div class="value-card"><div class="vicon">🎯</div><h4>Misión</h4><p>Brindar asesoría financiera, contable, tributaria y laboral integral que impulse el crecimiento sostenible de nuestros clientes.</p></div>
      <div class="value-card"><div class="vicon">🔭</div><h4>Visión</h4><p>Ser la firma de asesoría empresarial líder en Ecuador, reconocida por la excelencia y confiabilidad de nuestro servicio.</p></div>
      <div class="value-card"><div class="vicon">🤝</div><h4>Compromiso</h4><p>Acompañamos a cada cliente con responsabilidad, ética profesional y total apego a la normativa vigente.</p></div>
      <div class="value-card"><div class="vicon">⭐</div><h4>Excelencia</h4><p>Buscamos la mejora continua en cada proceso, propuesta y resultado que entregamos a nuestros clientes.</p></div>
    </div>
  </div>

  <!-- Cómo trabajamos (metodología, sin fechas ni cifras no verificadas) -->
  <div class="section section-dark">
    <div class="section-header center">
      <span class="tag">Cómo trabajamos</span>
      <h2 class="section-title section-title-white">Metodología, no <span class="hi">solo procesamiento</span></h2>
    </div>
    <div class="dims-grid">
      <div class="dim-card">
        <div class="dim-icon">🔍</div>
        <h3>Diagnóstico primero</h3>
        <p>Evaluamos tu operación antes de proponer un alcance — nada de planes genéricos.</p>
      </div>
      <div class="dim-card">
        <div class="dim-icon">📐</div>
        <h3>Proceso definido</h3>
        <p>Cada plan tiene alcance, entregables y calendario claros desde el onboarding.</p>
      </div>
      <div class="dim-card">
        <div class="dim-icon">🔒</div>
        <h3>Confidencialidad</h3>
        <p>La información financiera de tu empresa se trata con estricta reserva profesional.</p>
      </div>
      <div class="dim-card">
        <div class="dim-icon">🧭</div>
        <h3>Acompañamiento real</h3>
        <p>Reuniones periódicas y recomendaciones, no solo reportes al final del mes.</p>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-header center">
      <span class="tag">Nuestro equipo</span>
      <h2 class="section-title">Los mejores <span class="hi">en cada área</span></h2>
      <p class="section-sub">Un equipo multidisciplinario, con especialistas dedicados a cada frente de tu empresa: finanzas, contabilidad, lo legal y la administración.</p>
    </div>
    <div class="team-grid">
      <div class="team-card"><div class="team-photo team-icon">💰</div><h4>Equipo Financiero</h4><span>Planificación y análisis financiero</span></div>
      <div class="team-card"><div class="team-photo team-icon">📊</div><h4>Equipo Contable</h4><span>Contabilidad y reportes financieros</span></div>
      <div class="team-card"><div class="team-photo team-icon">⚖️</div><h4>Equipo Legal</h4><span>Asesoría laboral y societaria</span></div>
      <div class="team-card"><div class="team-photo team-icon">🗂️</div><h4>Equipo Administrativo</h4><span>Gestión y trámites empresariales</span></div>
    </div>
  </div>

  <FinalCta sub="Solicita un Diagnóstico Empresarial DEVCORP 360 y descubre cómo podemos ayudarte.">
    <Fragment slot="title">Conversemos sobre <span>tu negocio</span></Fragment>
    <a class="btn-primary" href="/diagnostico/" onclick="dcTrack('click_diagnostico', { location: 'nosotros' })">Solicitar diagnóstico →</a>
    <a class="btn-wa" href={waLink(WA_MESSAGES.general)} target="_blank" rel="noopener" onclick="dcTrack('click_whatsapp', { location: 'nosotros' })">Hablar por WhatsApp</a>
  </FinalCta>
</Base>
